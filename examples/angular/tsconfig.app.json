{
    // the app's compilation (@analogjs/vite-plugin-angular emits through it: no `noEmit`)
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false
    },
    "include": [
        "src/**/*.ts",
        "../../packages/angular/src/**/*.ts",
        "../../packages/angular/draggable/**/*.ts",
        "../../packages/angular/droppable/**/*.ts",
        "../../packages/angular/sortable/**/*.ts",
        "../../packages/angular/swappable/**/*.ts"
    ]
}
