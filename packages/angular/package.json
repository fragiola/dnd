{
    "name": "@fragiola/dnd-angular",
    "version": "0.1.1",
    "description": "Headless, composable Angular drag and drop over @fragiola/dnd: attribute directives on your own elements, no provider, one entry per capability, styled entirely by you.",
    "keywords": [
        "angular",
        "drag-and-drop",
        "dnd",
        "draggable",
        "droppable",
        "sortable",
        "swappable",
        "headless",
        "accessibility"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/dnd.git",
        "directory": "packages/angular"
    },
    "homepage": "https://fragiola.com/dnd",
    "bugs": {
        "url": "https://github.com/fragiola/dnd/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/public-api.ts",
            "types": "./dist/types/fragiola-dnd-angular.d.ts",
            "default": "./dist/fesm2022/fragiola-dnd-angular.mjs"
        },
        "./draggable": {
            "@fragiola/source": "./draggable/public-api.ts",
            "types": "./dist/types/fragiola-dnd-angular-draggable.d.ts",
            "default": "./dist/fesm2022/fragiola-dnd-angular-draggable.mjs"
        },
        "./droppable": {
            "@fragiola/source": "./droppable/public-api.ts",
            "types": "./dist/types/fragiola-dnd-angular-droppable.d.ts",
            "default": "./dist/fesm2022/fragiola-dnd-angular-droppable.mjs"
        },
        "./sortable": {
            "@fragiola/source": "./sortable/public-api.ts",
            "types": "./dist/types/fragiola-dnd-angular-sortable.d.ts",
            "default": "./dist/fesm2022/fragiola-dnd-angular-sortable.mjs"
        },
        "./swappable": {
            "@fragiola/source": "./swappable/public-api.ts",
            "types": "./dist/types/fragiola-dnd-angular-swappable.d.ts",
            "default": "./dist/fesm2022/fragiola-dnd-angular-swappable.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "directory": "dist",
        "linkDirectory": false
    },
    "scripts": {
        "build": "ng-packagr -p ng-package.json -c tsconfig.build.json && node scripts/publish-manifest.ts",
        "typecheck": "ngc -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@fragiola/dnd": "workspace:*"
    },
    "peerDependencies": {
        "@angular/core": "^22.0.0"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "2.9.6",
        "@analogjs/vitest-angular": "2.9.6",
        "@angular/build": "22.2.6",
        "@angular/common": "22.2.5",
        "@angular/compiler": "22.2.5",
        "@angular/compiler-cli": "22.2.5",
        "@angular/core": "22.2.5",
        "@angular/platform-browser": "22.2.5",
        "@angular/platform-server": "22.2.5",
        "@testing-library/jest-dom": "7.0.1",
        "jsdom": "31.0.0",
        "ng-packagr": "22.2.6",
        "rxjs": "7.8.2",
        "tsdown": "0.23.7",
        "typescript": "6.0.3",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    }
}
