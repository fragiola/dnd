{
    "name": "@fragiola/dnd",
    "version": "0.0.0",
    "description": "Headless drag and drop core: a drag space per document, pointer and keyboard sensors, collision strategies and the draggable and droppable capabilities, framework-free and dependency-free.",
    "keywords": [
        "drag-and-drop",
        "dnd",
        "draggable",
        "droppable",
        "headless",
        "accessibility",
        "pointer-events"
    ],
    "license": "MIT",
    "type": "module",
    "author": {
        "name": "Mauro de Souza",
        "email": "maurodesouza.me@gmail.com",
        "url": "https://github.com/maurodesouza"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fragiola/dnd.git",
        "directory": "packages/core"
    },
    "homepage": "https://fragiola.com/dnd",
    "bugs": {
        "url": "https://github.com/fragiola/dnd/issues"
    },
    "sideEffects": false,
    "exports": {
        ".": {
            "@fragiola/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./draggable": {
            "@fragiola/source": "./src/draggable/index.ts",
            "types": "./dist/draggable.d.ts",
            "import": "./dist/draggable.js",
            "default": "./dist/draggable.js"
        },
        "./droppable": {
            "@fragiola/source": "./src/droppable/index.ts",
            "types": "./dist/droppable.d.ts",
            "import": "./dist/droppable.js",
            "default": "./dist/droppable.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./draggable": {
                "types": "./dist/draggable.d.ts",
                "import": "./dist/draggable.js",
                "default": "./dist/draggable.js"
            },
            "./droppable": {
                "types": "./dist/droppable.d.ts",
                "import": "./dist/droppable.js",
                "default": "./dist/droppable.js"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "jsdom": "31.0.0",
        "tsdown": "0.23.7",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    }
}
